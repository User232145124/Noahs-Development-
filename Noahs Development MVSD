local ShootGun = ReplicatedStorage:FindFirstChild("Remotes")
    and ReplicatedStorage.Remotes:FindFirstChild("ShootGun")

local function RBOrigin()
    local c = LP.Character
    local h = c and c:FindFirstChild("Head")
    return h and h.Position
        or (Camera and Camera.CFrame.Position)
        or (c and c:FindFirstChild("HumanoidRootPart") and c.HumanoidRootPart.Position)
        or Vector3.zero
end

local function RBTarget()
    local c = LP.Character
    local r = c and c:FindFirstChild("HumanoidRootPart"); if not r then return nil end
    local bp, bd
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP or not pl.Character then continue end
        local hum  = pl.Character:FindFirstChildOfClass("Humanoid")
        local part = pl.Character:FindFirstChild(Cfg.RBTargetPart)
                  or pl.Character:FindFirstChild("HumanoidRootPart")
        if not hum or not part then continue end
        if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then continue end
        local d = (part.Position - r.Position).Magnitude
        if d <= Cfg.MaxDistRB and (not bd or d < bd) then bp, bd = part, d end
    end
    if bp then return bp, bp.Position end
    return nil
end

local lastFire = 0
RunService.Heartbeat:Connect(function()
    if not Cfg.RBEnabled or not ShootGun then return end
    local now = os.clock()
    if now - lastFire < Cfg.RBCooldown then return end
    local part, pos = RBTarget()
    if part and pos then lastFire = now; ShootGun:FireServer(RBOrigin(), pos, part, pos) end
end)

