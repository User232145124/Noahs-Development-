    btn.Text = Cfg[cfgKey] .. "  ▾"; btn.Parent = row
    Corner(6, btn); Stroke(C.border,1,0,btn)

    local open = false
    local listF = Instance.new("Frame")
    listF.Size = UDim2.new(0,120,0,#options*28+4)
    listF.Position = UDim2.new(1,-132,1,4)
    listF.BackgroundColor3 = C.panel; listF.BorderSizePixel = 0
    listF.Visible = false; listF.ZIndex = 10; listF.Parent = row
    Corner(6, listF); Stroke(C.border,1,0,listF)
    VList(1, listF); Pad(2,2,2,2,listF)

    local function Pick(opt)
        Cfg[cfgKey] = opt; btn.Text = opt .. "  ▾"
        listF.Visible = false; open = false
    end
    for _, opt in ipairs(options) do
        local ob = Instance.new("TextButton")
        ob.Size = UDim2.new(1,0,0,26); ob.BackgroundColor3 = C.surface
        ob.BackgroundTransparency = 0; ob.BorderSizePixel = 0
        ob.TextSize = 11; ob.Font = Enum.Font.Gotham; ob.TextColor3 = C.sub
        ob.Text = opt; ob.ZIndex = 11; ob.Parent = listF; Corner(4, ob)
        ob.MouseButton1Click:Connect(function() Pick(opt) end)
        ob.MouseEnter:Connect(function() Tween(ob,0.08,{BackgroundColor3=C.surfaceHov,TextColor3=C.text}) end)
        ob.MouseLeave:Connect(function() Tween(ob,0.08,{BackgroundColor3=C.surface,   TextColor3=C.sub}) end)
    end

    btn.MouseButton1Click:Connect(function()
        open = not open; listF.Visible = open
    end)
end

