        if ToggleRefs.SAEnabled then ToggleRefs.SAEnabled.setVis(Cfg.SAEnabled) end
        Notif("Silent Aim", Cfg.SAEnabled and "on" or "off")
    elseif k == Cfg.Keys.ToggleRB then
        Cfg.RBEnabled = not Cfg.RBEnabled
        if ToggleRefs.RBEnabled then ToggleRefs.RBEnabled.setVis(Cfg.RBEnabled) end
        Notif("Ragebot", Cfg.RBEnabled and "on" or "off")
    end
end)
