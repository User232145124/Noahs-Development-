-- 6. SILENT AIM
-- ─────────────────────────────────────────────────────────────────────────────
local function SAFilter(filterList, ignoreChar)
    local f = filterList and {table.unpack(filterList)} or {}
    local function addChar(char)
        if not char then return end
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then table.insert(f, v) end
        end
    end
    addChar(LP.Character); addChar(ignoreChar)
    return f
end

local function SurfacePoints(part)
    local cf = part.CFrame; local s = part.Size
    local hx, hy = s.X/2, s.Y/2
    local pts = {
        Vector3.new(0,0,0), Vector3.new(hx,hy,0), Vector3.new(-hx,hy,0),
        Vector3.new(hx,-hy,0), Vector3.new(-hx,-hy,0),
        Vector3.new(0,hy,0), Vector3.new(0,-hy,0),
        Vector3.new(hx,0,0), Vector3.new(-hx,0,0),
    }
    local out = {}
    for _, lp in ipairs(pts) do table.insert(out, cf:PointToWorldSpace(lp)) end
    return out
end

local function VisiblePoint(part, origin, filter)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = filter
    for _, pt in ipairs(SurfacePoints(part)) do
        local r = workspace:Raycast(origin, pt - origin, p)
        if not r or r.Instance:IsDescendantOf(part.Parent) then return pt end
    end
    return nil
end

local function SAGetTarget(filterList, ignoreChar)
    local origin   = Camera.CFrame.Position
    local mousePos = UserInputService:GetMouseLocation()
    local filter   = SAFilter(filterList, ignoreChar)
    local visible  = {}

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LP then continue end
        local char = pl.Character; if not char then continue end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local pParts = {}
        for _, part in ipairs(char:GetDescendants()) do
            if not part:IsA("BasePart") then continue end
            if (part.Position - origin).Magnitude > Cfg.MaxDistSA then continue end
            local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then continue end
            local vp = VisiblePoint(part, origin, filter)
            if not vp then continue end
            local sd = (Vector2.new(sp.X,sp.Y) - mousePos).Magnitude
            table.insert(pParts, {part=part, hitPoint=vp, sd=sd})
        end
        if #pParts == 0 then continue end
        table.sort(pParts, function(a,b) return a.sd < b.sd end)
        if #pParts == 1 then
            table.insert(visible, pParts[1])
        else
            local tot, wts = 0, {}
            for _, e in ipairs(pParts) do
                local w = 1/math.max(e.sd^Cfg.SARandomWeight, 0.001)
                table.insert(wts, w); tot = tot + w
            end
            local roll, cum = math.random()*tot, 0
            for i, e in ipairs(pParts) do
                cum = cum + wts[i]
                if roll <= cum then table.insert(visible, e); break end
            end
        end
    end
    if #visible == 0 then return nil, nil end
    table.sort(visible, function(a,b) return a.sd < b.sd end)
    local picked = visible[1]
    return picked.part, picked.hitPoint
end

local ok, WRC = pcall(function() return require(ReplicatedStorage.Modules.WeaponRaycast) end)
if ok and WRC then
    local mt = getrawmetatable(WRC); setreadonly(mt, false)
    local orig = mt.__call
    mt.__call = newcclosure(function(self, origin, endpoint, ignoreChar, colGroup, filterList)
        local tool   = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
        local isGun  = tool
            and tool:FindFirstChild("Fire")   and tool.Fire:IsA("Sound")
            and tool:FindFirstChild("Reload") and tool.Reload:IsA("Sound")
        if not Cfg.SAEnabled or not isGun then
            return orig(self, origin, endpoint, ignoreChar, colGroup, filterList)
        end
        local target, hitPt = SAGetTarget(filterList, ignoreChar)
        if not target or not hitPt then
            return orig(self, origin, endpoint, ignoreChar, colGroup, filterList)
        end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = SAFilter(filterList, ignoreChar)
        if colGroup then rp.CollisionGroup = colGroup end
        local confirm = workspace:Raycast(origin, hitPt - origin, rp)
        if not confirm or confirm.Instance:IsDescendantOf(target.Parent) then
            return {
                Position = hitPt + Cfg.SAHitOffset,
                Instance = target,
                Normal   = (origin - hitPt).Unit,
                Material = Enum.Material.SmoothPlastic,
            }
        end
        return orig(self, origin, endpoint, ignoreChar, colGroup, filterList)
    end)
    setreadonly(mt, true)
end

