local ToggleRefs = {}

local function MakeToggle(labelTxt, subTxt, cfgKey, kbKey, order)
    local row = Instance.new("Frame")
    row.Size              = UDim2.new(1,0,0,54)
    row.BackgroundColor3  = C.surface
    row.BackgroundTransparency = 0
    row.BorderSizePixel   = 0
    row.LayoutOrder       = order
    row.Parent            = Scroll
    Corner(8, row)
    Stroke(C.border,1,0,row)

    local lbl = Label(labelTxt, 13, C.text, Enum.Font.Gotham, row)
    lbl.Size = UDim2.new(0.55,0,0,18); lbl.Position = UDim2.new(0,12,0,10)
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local sub = Label(subTxt, 10, C.sub, Enum.Font.Gotham, row)
    sub.Size = UDim2.new(0.55,0,0,14); sub.Position = UDim2.new(0,12,0,28)
    sub.TextXAlignment = Enum.TextXAlignment.Left

    -- keybind chip — click to rebind
    local kb = Instance.new("TextButton")
    kb.Size = UDim2.new(0,0,0,18); kb.AutomaticSize = Enum.AutomaticSize.X
    kb.Position = UDim2.new(1,-98,0.5,-9)
    kb.BackgroundColor3 = C.panel; kb.BackgroundTransparency = 0
    kb.BorderSizePixel = 0; kb.TextSize = 10; kb.Font = Enum.Font.Gotham
    kb.TextColor3 = C.sub
    kb.Text = " " .. tostring(Cfg.Keys[kbKey]):gsub("Enum%.KeyCode%.","") .. " "
    kb.Parent = row; Corner(4, kb); Stroke(C.border,1,0,kb)

    local rebinding = false
    kb.MouseButton1Click:Connect(function()
        if rebinding then return end
        rebinding = true
        kb.Text = "  …  "; kb.TextColor3 = C.accent
        local conn; conn = UserInputService.InputBegan:Connect(function(inp, gp)
            if gp then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                Cfg.Keys[kbKey] = inp.KeyCode
                kb.Text = " " .. tostring(inp.KeyCode):gsub("Enum%.KeyCode%.","") .. " "
                kb.TextColor3 = C.sub
                rebinding = false
                conn:Disconnect()
            end
        end)
    end)
    kb.MouseEnter:Connect(function() if not rebinding then Tween(kb,0.08,{TextColor3=C.accent}) end end)
    kb.MouseLeave:Connect(function() if not rebinding then Tween(kb,0.08,{TextColor3=C.sub}) end end)

    -- pill toggle
    local pillBG = Instance.new("Frame")
    pillBG.Size = UDim2.new(0,44,0,24); pillBG.Position = UDim2.new(1,-54,0.5,-12)
    pillBG.BackgroundColor3 = C.offBG; pillBG.BorderSizePixel = 0; pillBG.Parent = row
    Corner(12, pillBG); Stroke(C.border,1,0,pillBG)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0,18,0,18); knob.Position = UDim2.new(0,3,0.5,-9)
    knob.BackgroundColor3 = C.off; knob.BorderSizePixel = 0; knob.Parent = pillBG
    Corner(9, knob)

    local function SetVis(state)
        Tween(knob,   0.15, {Position = state and UDim2.new(0,23,0.5,-9) or UDim2.new(0,3,0.5,-9),
                              BackgroundColor3 = state and C.on or C.off})
        Tween(pillBG, 0.15, {BackgroundColor3 = state and C.onBG or C.offBG})
        Tween(row,    0.10, {BackgroundColor3 = state and C.surfaceHov or C.surface})
    end
    SetVis(Cfg[cfgKey])

    local function DoToggle()
        Cfg[cfgKey] = not Cfg[cfgKey]; SetVis(Cfg[cfgKey])
    end

    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1,-106,1,0); hit.BackgroundTransparency = 1; hit.Text = ""; hit.Parent = row
    hit.MouseButton1Click:Connect(DoToggle)
    pillBG.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then DoToggle() end
    end)
    row.MouseEnter:Connect(function() if not Cfg[cfgKey] then Tween(row,0.1,{BackgroundColor3=C.surfaceHov}) end end)
    row.MouseLeave:Connect(function() if not Cfg[cfgKey] then Tween(row,0.1,{BackgroundColor3=C.surface}) end end)

    ToggleRefs[cfgKey] = { setVis = SetVis, doToggle = DoToggle }
end

-- ── slider row ─────────────────────────────────────────────────────────────
local function MakeSlider(labelTxt, cfgKey, minVal, maxVal, decimals, order)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,0,0,52); row.BackgroundColor3 = C.surface
    row.BackgroundTransparency = 0; row.BorderSizePixel = 0
    row.LayoutOrder = order; row.Parent = Scroll
    Corner(8, row); Stroke(C.border,1,0,row)

    local lbl = Label(labelTxt, 12, C.text, Enum.Font.Gotham, row)
    lbl.Size = UDim2.new(0.6,0,0,16); lbl.Position = UDim2.new(0,12,0,8)
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local fmt = decimals > 0 and ("%." .. decimals .. "f") or "%d"
    local valLbl = Label(string.format(fmt, Cfg[cfgKey]), 11, C.accent, Enum.Font.GothamBold, row)
    valLbl.Size = UDim2.new(0.4,-12,0,16); valLbl.Position = UDim2.new(0.6,0,0,8)
    valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1,-24,0,4); track.Position = UDim2.new(0,12,0,34)
    track.BackgroundColor3 = C.border; track.BorderSizePixel = 0; track.Parent = row
    Corner(2, track)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((Cfg[cfgKey]-minVal)/(maxVal-minVal),0,1,0)
    fill.BackgroundColor3 = C.accent; fill.BorderSizePixel = 0; fill.Parent = track
    Corner(2, fill)

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0,12,0,12); thumb.AnchorPoint = Vector2.new(0.5,0.5)
    thumb.Position = UDim2.new((Cfg[cfgKey]-minVal)/(maxVal-minVal),0,0.5,0)
    thumb.BackgroundColor3 = C.text; thumb.BorderSizePixel = 0; thumb.Parent = track
    Corner(6, thumb)

    local dragging = false
    local function UpdateSlider(absX)
        local tx = track.AbsolutePosition.X
        local tw = track.AbsoluteSize.X
        local t  = math.clamp((absX - tx) / tw, 0, 1)
        local v  = minVal + t * (maxVal - minVal)
        if decimals == 0 then v = math.round(v) end
        Cfg[cfgKey] = v
        fill.Size      = UDim2.new(t,0,1,0)
        thumb.Position = UDim2.new(t,0,0.5,0)
        valLbl.Text    = string.format(fmt, v)
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; UpdateSlider(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            UpdateSlider(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

