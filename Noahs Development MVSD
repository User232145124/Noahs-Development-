-- 3. CONFIG PERSISTENCE
-- ─────────────────────────────────────────────────────────────────────────────
local CONFIG_DIR    = "nd_configs"
local AUTOLOAD_FILE = CONFIG_DIR .. "/autoload.txt"

local function EnsureDir()
    if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
end

local function SerializeCfg()
    return HttpService:JSONEncode({
        ESPEnabled     = Cfg.ESPEnabled,
        SAEnabled      = Cfg.SAEnabled,
        RBEnabled      = Cfg.RBEnabled,
        MaxDistESP     = Cfg.MaxDistESP,
        MaxDistSA      = Cfg.MaxDistSA,
        SARandomWeight = Cfg.SARandomWeight,
        MaxDistRB      = Cfg.MaxDistRB,
        RBCooldown     = Cfg.RBCooldown,
        RBTargetPart   = Cfg.RBTargetPart,
        Keys = {
            ToggleMenu = tostring(Cfg.Keys.ToggleMenu),
            ToggleESP  = tostring(Cfg.Keys.ToggleESP),
            ToggleSA   = tostring(Cfg.Keys.ToggleSA),
            ToggleRB   = tostring(Cfg.Keys.ToggleRB),
        },
    })
end

local function ApplySaved(t)
    if not t then return end
    for _, k in ipairs({"ESPEnabled","SAEnabled","RBEnabled","MaxDistESP","MaxDistSA",
                         "SARandomWeight","MaxDistRB","RBCooldown","RBTargetPart"}) do
        if t[k] ~= nil then Cfg[k] = t[k] end
    end
    if t.Keys then
        for _, k in ipairs({"ToggleMenu","ToggleESP","ToggleSA","ToggleRB"}) do
            if t.Keys[k] then
                local kc = Enum.KeyCode[t.Keys[k]:gsub("Enum%.KeyCode%.","")]
                if kc then Cfg.Keys[k] = kc end
            end
        end
    end
end

local function SaveConfig(name)
    EnsureDir()
    writefile(CONFIG_DIR .. "/" .. name .. ".json", SerializeCfg())
end

local function LoadConfig(name)
    local path = CONFIG_DIR .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    local ok, t = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if ok and t then ApplySaved(t); return true end
    return false
end

local function DeleteConfig(name)
    local path = CONFIG_DIR .. "/" .. name .. ".json"
    if isfile(path) then delfile(path) end
end

local function ListConfigs()
    EnsureDir()
    local out = {}
    for _, f in ipairs(listfiles(CONFIG_DIR)) do
        local n = f:match("([^/\\]+)%.json$")
        if n then table.insert(out, n) end
    end
    return out
end

local function GetAutoload()
    if isfile(AUTOLOAD_FILE) then return readfile(AUTOLOAD_FILE):match("^%s*(.-)%s*$") end
    return nil
end

local function SetAutoload(name)
    EnsureDir()
    if name and name ~= "" then
        writefile(AUTOLOAD_FILE, name)
    else
        if isfile(AUTOLOAD_FILE) then delfile(AUTOLOAD_FILE) end
    end
end

do
    local al = GetAutoload()
    if al and al ~= "" then LoadConfig(al) end
end

