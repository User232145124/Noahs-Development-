-- ─────────────────────────────────────────────────────────────────────────────
-- CORNER RESIZE HANDLES
-- ─────────────────────────────────────────────────────────────────────────────
do
    -- Four corners: TL / TR / BL / BR
    -- Each handle is a transparent 14×14 zone; dragging adjusts Panel size + position.
    local corners = {
        { name = "TL", anchorX = 0,   anchorY = 0,   posX = 0,  posY = 0  },
        { name = "TR", anchorX = 1,   anchorY = 0,   posX = 1,  posY = 0  },
        { name = "BL", anchorX = 0,   anchorY = 1,   posX = 0,  posY = 1  },
        { name = "BR", anchorX = 1,   anchorY = 1,   posX = 1,  posY = 1  },
    }

    for _, def in ipairs(corners) do
        local handle = Instance.new("Frame")
        handle.Name                  = "Resize_" .. def.name
        handle.Size                  = UDim2.new(0, HANDLE_SIZE, 0, HANDLE_SIZE)
        handle.AnchorPoint           = Vector2.new(def.anchorX, def.anchorY)
        handle.Position              = UDim2.new(def.posX, 0, def.posY, 0)
        handle.BackgroundTransparency= 1
        handle.ZIndex                = 20
        handle.Parent                = Panel

        local resizing   = false
        local startMouse = nil
        local startSize  = nil
        local startPos   = nil

        handle.InputBegan:Connect(function(i)
            if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            resizing   = true
            startMouse = Vector2.new(i.Position.X, i.Position.Y)
            startSize  = Vector2.new(Panel.AbsoluteSize.X, Panel.AbsoluteSize.Y)
            startPos   = Vector2.new(Panel.AbsolutePosition.X, Panel.AbsolutePosition.Y)
        end)

        UserInputService.InputChanged:Connect(function(i)
            if not resizing then return end
            if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end

            local dx = i.Position.X - startMouse.X
            local dy = i.Position.Y - startMouse.Y

            local newW = startSize.X
            local newH = startSize.Y
            local newX = startPos.X
            local newY = startPos.Y

            -- horizontal
            if def.anchorX == 0 then
                -- left edge: move left edge right/left
                newW = math.max(PANEL_MIN_W, startSize.X - dx)
                newX = startPos.X + (startSize.X - newW)
            else
                -- right edge: extend right
                newW = math.max(PANEL_MIN_W, startSize.X + dx)
            end

            -- vertical
            if def.anchorY == 0 then
                -- top edge: move top edge
                newH = math.max(PANEL_MIN_H, startSize.Y - dy)
                newY = startPos.Y + (startSize.Y - newH)
            else
                -- bottom edge: extend down
                newH = math.max(PANEL_MIN_H, startSize.Y + dy)
            end

            Panel.Size     = UDim2.new(0, newW, 0, newH)
            Panel.Position = UDim2.new(0, newX, 0, newY)
        end)

        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                resizing = false
            end
        end)
    end
end

